# PWA deployment base path. Must start and end with a slash.
VITE_PWA_BASE=/swipyrss/

# Same-origin FreshRSS Google Reader API path requested by the browser.
VITE_FRESHRSS_API_BASE=/api/greader.php

# Used by npm run dev:web and npm run preview. Vite proxies same-origin browser requests to this server.
VITE_FRESHRSS_DEV_TARGET=https://rss.example.com
